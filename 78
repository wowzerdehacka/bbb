local UIS, RS, P = game:GetService("UserInputService"), game:GetService("ReplicatedStorage"), game:GetService("Players")
local plr = P.LocalPlayer

local function fire(m)
	local char = plr.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local id = RS.src.Identities[char:GetAttribute("Character")][char:GetAttribute("Identity")]
	local t = workspace.Map["Noon of Violet"].Charon
	for _ = 1, 555555555555 do
		RS.Net.Character.Combat:FireServer({Attempt = "EGOSkill", Char = char, HRP = char.HumanoidRootPart, Module = id.Moves.Base[m], Counter = true, Target = t})
		task.wait(0)
	end
end
