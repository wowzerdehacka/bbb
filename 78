-- Convert blacklist into a quick-lookup map (case-insensitive)
local BlacklistedNames = {}
for _, name in ipairs(Blacklist) do
    BlacklistedNames[string.lower(name)] = true
end

local function checkPlayer(player)
    if player == LocalPlayer then return end
    
    local nameMatch = BlacklistedNames[string.lower(player.Name)]
    local displayNameMatch = BlacklistedNames[string.lower(player.DisplayName)]
    
    if nameMatch or displayNameMatch then
        LocalPlayer:Kick("Blacklisted player detected in server: " .. player.Name)
    end
end

-- 1. Check players already in the server upon joining
for _, player in ipairs(Players:GetPlayers()) do
    checkPlayer(player)
end

-- 2. Monitor new players joining the server
Players.PlayerAdded:Connect(checkPlayer)


